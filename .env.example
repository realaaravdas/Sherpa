# ── Required for public hosting ──────────────────────────────
NODE_ENV=production
# Long random string (>= 32 chars). Used as a password "pepper"; changing it invalidates all passwords.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Number of reverse-proxy hops in front of the app (1 for nginx/Caddy/Cloudflare tunnel). Needed for correct client IPs / rate limits.
TRUST_PROXY=1

# ── AI (NVIDIA NIM) ──────────────────────────────────────────
# Get a key at https://build.nvidia.com . Optional: users can also paste their own key in Settings.
NVIDIA_API_KEY=
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_CHAT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct     # falls back automatically if retired
# NIM_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1

# ── Optional ─────────────────────────────────────────────────
# PORT=3000
# DATA_DIR=./data                 # SQLite database + generated secret live here (mount a volume!)
# ALLOW_REGISTRATION=true         # set false to close sign-ups after creating your accounts
# SESSION_DAYS=30
# SCRAPE_INTERVAL_MIN=180         # background refresh of the job pool; 0 disables
# JOB_STALE_DAYS=10               # aggregator jobs not seen for this long are closed
# COOKIE_SECURE=true              # defaults to true in production; needs HTTPS
