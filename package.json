    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "undici": "^8.12.2",
    "unpdf": "^1.9.1"
  }
}
