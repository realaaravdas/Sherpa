{
  "name": "sherpa",
  "version": "1.0.0",
  "description": "Sherpa — an AI job-search copilot: multi-source job scraping, smart matching, and an application tracker.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "NODE_USE_ENV_PROXY=1 node --disable-warning=ExperimentalWarning src/server.js",
